# Salin ke Environment Variables di dashboard Vercel (JANGAN commit file .env berisi rahasia!)

# 1. Server Key Midtrans Sandbox (dari dashboard.sandbox.midtrans.com -> Settings -> Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-GANTI_DENGAN_SERVER_KEY_SANDBOX

# 2. Pastikan false untuk lingkungan Sandbox (tanpa uang asli)
MIDTRANS_IS_PRODUCTION=false

# 3. Isi lengkap file JSON Service Account Firebase (boleh 1 baris JSON atau hasil encode Base64)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
