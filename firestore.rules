rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAsisten() {
      return signedIn() && profile().role == 'ASISTEN';
    }

    function isPraktikan() {
      return signedIn() && profile().role == 'PRAKTIKAN';
    }

    function validText(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nama', 'nim', 'email', 'role'])
        && request.resource.data.uid == uid
        && validText(request.resource.data.nama, 1, 120)
        && validText(request.resource.data.nim, 1, 40)
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.role == 'PRAKTIKAN';
      allow read: if signedIn() && (request.auth.uid == uid || isAsisten());
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nama', 'nim', 'email', 'role'])
        && request.resource.data.uid == uid
        && resource.data.uid == uid
        && validText(request.resource.data.nama, 1, 120)
        && validText(request.resource.data.nim, 1, 40)
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /labs/{labId} {
      allow read: if signedIn();
      allow create, update: if isAsisten()
        && request.resource.data.keys().hasOnly([
          'nama', 'gedung', 'latitude', 'longitude', 'radiusMeter',
          'dibuatPada', 'diubahPada'
        ])
        && validText(request.resource.data.nama, 1, 120)
        && (!('gedung' in request.resource.data)
          || validText(request.resource.data.gedung, 0, 160))
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radiusMeter is number
        && request.resource.data.radiusMeter > 0
        && request.resource.data.radiusMeter <= 250;
      allow delete: if isAsisten();
    }

    match /users/{uid}/fcmTokens/{token} {
      allow read: if signedIn() && (request.auth.uid == uid || isAsisten());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['platform', 'diperbaruiPada'])
        && request.resource.data.platform in ['android', 'ios'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /classes/{classId} {
      allow read: if isAsisten()
        || (isPraktikan() && request.auth.uid in resource.data.pesertaUids);
      allow write: if isAsisten();
    }

    match /sessions/{sessionId} {
      allow read: if isAsisten()
        || (isPraktikan()
          && request.auth.uid in get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.pesertaUids);
      allow write: if isAsisten();

      match /attendance/{uid} {
        allow read: if isAsisten() || (isPraktikan() && request.auth.uid == uid);
        // Attendance Sprint 3 is written only by the Admin SDK in
        // functions/src/index.ts after server-side location validation.
        allow create: if false;
        allow update: if false;
        allow delete: if isAsisten();
      }
    }

    match /permissions/{permissionId} {
      allow read: if isAsisten() || (isPraktikan() && resource.data.uid == request.auth.uid);
      allow create: if isPraktikan() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid', 'sessionId', 'alasan', 'kategoriAI', 'statusAI', 'status',
          'diputuskanOleh', 'dibuatPada', 'diputuskanPada'
        ])
        && request.resource.data.sessionId is string
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() > 0
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.classId)).data.pesertaUids;
      allow update: if (
          isPraktikan()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.alasan == resource.data.alasan
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kategoriAI', 'statusAI'])
        ) || (
          isAsisten()
          && resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.alasan == resource.data.alasan
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diputuskanOleh == request.auth.uid
          && request.resource.data.diputuskanPada == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'diputuskanOleh', 'diputuskanPada'
          ])
        );
      allow delete: if false;
    }
  }
}
