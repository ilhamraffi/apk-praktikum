rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAslab() {
      return signedIn() && profile().role == 'ASLAB';
    }

    function isAsisten() {
      return signedIn() && profile().role == 'ASISTEN';
    }

    function isPengelola() {
      return isAslab() || isAsisten();
    }

    function isPraktikan() {
      return signedIn() && profile().role == 'PRAKTIKAN';
    }

    function validText(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    function sessionClassId(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.classId;
    }

    function isPesertaKelas(classId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/classes/$(classId)).data.pesertaUids;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nama', 'nim', 'email', 'role'])
        && request.resource.data.uid == uid
        && validText(request.resource.data.nama, 1, 120)
        && validText(request.resource.data.nim, 1, 40)
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.role == 'PRAKTIKAN';
      allow read: if signedIn() && (request.auth.uid == uid || isPengelola());
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nama', 'nim', 'email', 'role', 'labIds'])
        && request.resource.data.uid == uid
        && resource.data.uid == uid
        && validText(request.resource.data.nama, 1, 120)
        && validText(request.resource.data.nim, 1, 40)
        && validText(request.resource.data.email, 3, 254)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /labs/{labId} {
      allow read: if signedIn();
      // SRS-17 & SRS-18: pengelolaan laboratorium, distribusi praktikan/asprak,
      // serta kebijakan radius & keterlambatan hanya boleh ditulis oleh ASLAB.
      allow create, update: if isAslab()
        && request.resource.data.keys().hasOnly([
          'nama', 'gedung', 'mataKuliah', 'latitude', 'longitude', 'radiusMeter',
          'gracePeriodMenit', 'nominalDenda',
          'aslabUids', 'asprakUids', 'praktikanUids',
          'dibuatPada', 'diubahPada'
        ])
        && validText(request.resource.data.nama, 1, 120)
        && (!('gedung' in request.resource.data)
          || validText(request.resource.data.gedung, 0, 160))
        && (!('mataKuliah' in request.resource.data)
          || validText(request.resource.data.mataKuliah, 0, 120))
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radiusMeter is number
        && request.resource.data.radiusMeter > 0
        && request.resource.data.radiusMeter <= 250
        && (!('gracePeriodMenit' in request.resource.data)
          || (request.resource.data.gracePeriodMenit is number
            && request.resource.data.gracePeriodMenit >= 0
            && request.resource.data.gracePeriodMenit <= 180))
        && (!('nominalDenda' in request.resource.data)
          || (request.resource.data.nominalDenda is number
            && request.resource.data.nominalDenda >= 0
            && request.resource.data.nominalDenda <= 1000000))
        && (!('aslabUids' in request.resource.data)
          || request.resource.data.aslabUids is list)
        && (!('asprakUids' in request.resource.data)
          || request.resource.data.asprakUids is list)
        && (!('praktikanUids' in request.resource.data)
          || request.resource.data.praktikanUids is list);
      allow delete: if isAslab();
    }

    match /users/{uid}/fcmTokens/{token} {
      allow read: if signedIn() && (request.auth.uid == uid || isPengelola());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['platform', 'diperbaruiPada'])
        && request.resource.data.platform in ['android', 'ios'];
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /classes/{classId} {
      allow read: if isPengelola()
        || (isPraktikan() && request.auth.uid in resource.data.pesertaUids);
      allow write: if isPengelola();
    }

    match /sessions/{sessionId} {
      allow read: if isPengelola()
        || (isPraktikan() && isPesertaKelas(resource.data.classId));
      allow write: if isPengelola();

      match /attendance/{uid} {
        allow read: if isPengelola() || (isPraktikan() && request.auth.uid == uid);
        // Presensi Sprint 3 & 4 ditulis hanya oleh backend Admin SDK setelah validasi
        // lokasi dan perhitungan keterlambatan.
        allow create: if false;
        allow update: if false;
        allow delete: if isPengelola();
      }
    }

    match /permissions/{permissionId} {
      allow read: if isPengelola()
        || (isPraktikan() && resource.data.uid == request.auth.uid);
      allow create: if isPraktikan()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid', 'sessionId', 'alasan', 'kategoriAI', 'statusAI', 'status',
          'diputuskanOleh', 'dibuatPada', 'diputuskanPada'
        ])
        && request.resource.data.sessionId is string
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() > 0
        && isPesertaKelas(sessionClassId(request.resource.data.sessionId));
      allow update: if (
          isPraktikan()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.alasan == resource.data.alasan
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'kategoriAI', 'statusAI'
          ])
        ) || (
          isPengelola()
          && resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.alasan == resource.data.alasan
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diputuskanOleh == request.auth.uid
          && request.resource.data.diputuskanPada == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'diputuskanOleh', 'diputuskanPada'
          ])
        );
      allow delete: if false;
    }

    match /fines/{fineId} {
      allow read: if isAslab()
        || (isPraktikan() && resource.data.uid == request.auth.uid);
      // Tagihan denda hanya dibuat & diperbarui oleh backend setelah validasi presensi / webhook Midtrans.
      allow write: if false;
    }

    match /payments/{orderId} {
      allow read: if isAslab()
        || (isPraktikan() && resource.data.uid == request.auth.uid);
      // Riwayat transaksi hanya ditulis oleh backend setelah membuat transaksi / verifikasi webhook Midtrans.
      allow write: if false;
    }
  }
}
